  "needs": {
    "Kalae Bay": {"needs": ["surf"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_4", "quote": "A single grassy island and a couple of low sandbars sit out in the water, but reaching any of them takes a Pok\u00e9 Ride you have not unlocked yet", "guide": "Pokemon Ultra Sun and Ultra Moon Official Alola Region Strategy Guide, p80: \"Until you have a Ride Pok\u00e9mon that can travel across the water, you'll only be able to explore one small corner\""},
    "Verdant Cavern Trial Site": {"needs": ["Normalium"], "src": "https://bulbapedia.bulbagarden.net/wiki/Verdant_Cavern", "quote": "Prior to completing the trial, [[wild Pokémon]] do not appear in Verdant Cavern"},
    "Route 1 South": {"needs": ["tauros"], "src": "https://bulbapedia.bulbagarden.net/wiki/Alola_Route_1", "quote": "Once the player has completed [[Hala]]'s grand trial, this part of Route 1 becomes accessible using [[Poké Ride|Tauros Charge]]."},
    "Melemele Sea": {"needs": ["surf"], "src": "https://bulbapedia.bulbagarden.net/wiki/Melemele_Sea", "quote": "Both areas, including the islands they contain, require either [[Poké Ride|Lapras Paddle]] or [[Poké Ride|Sharpedo Jet]] to access."},
    "Brooklet Hill South": {"needs": ["Waterium"], "src": "https://bulbapedia.bulbagarden.net/wiki/Brooklet_Hill", "quote": "Prior to completing the trial, [[wild Pokémon]] do not appear in the trial site (except trial Pokémon)."},
    "Lush Jungle East Cave": {"needs": ["aether", "Grassium", "machamp"], "src": "https://bulbapedia.bulbagarden.net/wiki/Lush_Jungle", "quote": "Cave ''(accessible with [[Poké Ride|Machamp Shove]] from the east area)''", "unlock_src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_22", "unlock_quote": "You find Hapu and her {{p|Mudsdale}} outside her house. When Lillie asks where the island's kahuna can be found, Hapu admits that Poni Island does not currently have one. She and Mudsdale ride off toward some nearby ruins, and her grandmother registers Machamp Shove to your Ride Pager before you go, a Poké Ride move strong enough to shove aside boulders blocking the path. The grandmother then directs you toward the [[Ruins of Hope]], reachable through [[Poni Breaker Coast]] to the south."},
    "Thrifty Megamart Abandoned Site": {"needs": ["Ghostium"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_18", "quote": "The trial starts the moment you step through the door, and there is nothing to catch inside until it is finished."},
    "Brooklet Hill Totems Den": {"needs": ["Waterium"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_8", "quote": "Lana warns that no wild Pokémon can be caught until you clear it"},
    "Lush Jungle": {"needs": ["Grassium"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_10", "quote": "wild Pokémon finally start turning up throughout the jungle"},
    "Route 12": {"needs": ["mudsdale"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_17", "quote": "Broken, rocky ground blocks most of the route from the outset"},
    "Ruins Of Life": {"needs": ["aether", "machamp"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_12", "quote": "a stone maze that needs Machamp's help to clear", "unlock_src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_22", "unlock_quote": "You find Hapu and her {{p|Mudsdale}} outside her house. When Lillie asks where the island's kahuna can be found, Hapu admits that Poni Island does not currently have one. She and Mudsdale ride off toward some nearby ruins, and her grandmother registers Machamp Shove to your Ride Pager before you go, a Poké Ride move strong enough to shove aside boulders blocking the path. The grandmother then directs you toward the [[Ruins of Hope]], reachable through [[Poni Breaker Coast]] to the south."},
    "Ruins Of Abundance": {"needs": ["aether", "machamp"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_29", "quote": "Push the blocks in the shrine's interior aside with Machamp Shove and continue to the altar, where Tapu Bulu will challenge you.", "unlock_src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_22", "unlock_quote": "You find Hapu and her {{p|Mudsdale}} outside her house. When Lillie asks where the island's kahuna can be found, Hapu admits that Poni Island does not currently have one. She and Mudsdale ride off toward some nearby ruins, and her grandmother registers Machamp Shove to your Ride Pager before you go, a Poké Ride move strong enough to shove aside boulders blocking the path. The grandmother then directs you toward the [[Ruins of Hope]], reachable through [[Poni Breaker Coast]] to the south."},
    "Ruins Of Hope": {"needs": ["aether", "machamp"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_23", "quote": "Inside the shrine, use Machamp Shove to push the nearest stone block all the way north", "unlock_src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_22", "unlock_quote": "You find Hapu and her {{p|Mudsdale}} outside her house. When Lillie asks where the island's kahuna can be found, Hapu admits that Poni Island does not currently have one. She and Mudsdale ride off toward some nearby ruins, and her grandmother registers Machamp Shove to your Ride Pager before you go, a Poké Ride move strong enough to shove aside boulders blocking the path. The grandmother then directs you toward the [[Ruins of Hope]], reachable through [[Poni Breaker Coast]] to the south."},
    "Resolution Cave": {"needs": ["mudsdale", "tauros"], "src": "https://bulbapedia.bulbagarden.net/wiki/Walkthrough:Pok%C3%A9mon_Ultra_Sun_and_Ultra_Moon/Part_33", "quote": "You will need [[Poké Ride|Mudsdale Gallop and Tauros Charge]] to navigate the cave."}
