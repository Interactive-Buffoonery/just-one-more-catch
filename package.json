{
  "name": "just-one-more-catch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "convex": "convex dev",
    "build": "vite build",
    "build:prod": "env -u VITE_CLERK_PUBLISHABLE_KEY vite build && (grep -qE 'pk_live_[A-Za-z0-9]{20,}' dist/assets/*.js || (echo 'No live Clerk key in the build. Add .env.production (see the main checkout).' >&2; exit 1))",
    "deploy": "convex deploy --cmd 'pnpm build:prod' && wrangler deploy"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.42.3",
    "@clerk/ui": "^1.42.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "cally": "0.9.2",
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  }
}
